API_ID=123456
API_HASH=your_api_hash
# آیدی عددی خودت (از @userinfobot) — فقط تو می‌تونی از باتا استفاده کنی
OWNER_ID=
# بات ۱ — مدیریت (الزامی): /start، فعالسازی با شماره + کیبورد کد، خاموش/روشن/حذف سلف (از @BotFather)
MANAGER_BOT_TOKEN=
# بات ۲ — هلپر (الزامی برای .پنل): پنل دکمه‌ای inline (از @BotFather + دستور /setinline)
HELPER_BOT_TOKEN=
# آیدی عددی گروهی که بازی‌ها (۲۱ و دوئل تاس) فقط توش کار کنن، مثل -1001234567890
# (از @userinfobot یا @getidsbot توی گروه بگیر). چندتا رو با کاما جدا کن. خالی = همه‌ی چت‌ها
GAME_CHAT_ID=
# مسیر عکس بنر خودت برای /start بات مدیریت (اختیاری)
BANNER_PATH=assets/banner.jpg
# پوشه‌ی بنرهای اختصاصی (عکس پروفایل هر کاربر وسط بنر NRT self ساخته می‌شه)
BANNER_DIR=banners
# برای دستور هوش مصنوعی (اختیاری)
ANTHROPIC_API_KEY=

# ===== حالت هاب چندکاربره (hub.py) — جدا از بات تکی بالا =====
# بات اصلیِ هاب: ثبت‌نام کاربرا، فعالسازی با شماره، نمایش موجودی/تست رایگان
HUB_BOT_TOKEN=
# آیدی عددی ادمین/ادمین‌ها (از @userinfobot)، با کاما جدا کن برای چندتا: 111,222
ADMIN_IDS=
# (اختیاری) بات هلپر مشترک برای «.پنل» همه‌ی کاربرا با هم
HUB_HELPER_BOT_TOKEN=
# هر الماس معادل چند ثانیه آنلاین‌بودنه (پیش‌فرض ۱۷۹۶ ثانیه ≈ نیم ساعت)
DIAMOND_SECONDS=1796
# طول تست رایگانِ هر کاربرِ جدید، به ثانیه (پیش‌فرض ۲ ساعت)
TRIAL_SECONDS=7200

# ===== پنل وب ادمین (hub.py) =====
# رمز پنل وب؛ خالی بذاری پنل وب خاموش می‌مونه. رمز قوی بذار!
WEB_PASSWORD=
# پیش‌فرض فقط از خود سرور (127.0.0.1) در دسترسه؛ برای بیرون: nginx/caddy + HTTPS یا SSH tunnel
# 0.0.0.0 = دسترسی مستقیم با http://IP:PORT (مثل پنل سنایی) | 127.0.0.1 = لوکال یا پشت دامنه/Caddy
WEB_HOST=127.0.0.1
# پورت دلخواه پنل وب (با bash setpanel.sh هم میشه عوض کرد)
WEB_PORT=8080
WEB_DOMAIN=
# پشت HTTPS بودی 1 بذار تا کوکی Secure بشه
WEB_SECURE=0

# ===== ظاهر و امکانات منوی هاب (اختیاری) =====
# اسم برند توی پیام خوش‌آمدگویی
BRAND=NRT Self
# هزینه‌ی فعالسازی سلف (الماس). اولین فعالسازی هر کاربر با ۲ ساعت تست رایگان مجانیه
ACTIVATION_COST=32
# جایزه‌ی دعوت هر زیرمجموعه (الماس)
REF_REWARD=5
# لینک چنل و گپ پشتیبانی (دکمه‌های منوی اصلی) و یوزرنیم پشتیبان برای «ارتباط مستقیم»
CHANNEL_URL=
SUPPORT_GROUP_URL=
SUPPORT_USERNAME=
# لیست قیمت خرید الماس به شکل «الماس:قیمت‌به‌تومان» با کاما جدا
PRICES=142:3550,450:11250,620:15500
# متن راهنمای پرداخت (مثلا شماره کارت) که زیر قیمت‌ها نشون داده می‌شه
PAY_INFO=

# متن پایین پنل (پیش‌فرض: Panel @یوزرنیم_هلپر)
PANEL_TAG=

# --- الماس و بازی ---
# هر الماس چند ثانیه سلف رو روشن نگه می‌داره. 1800 = هر ساعت ۲ الماس کم می‌شه
DIAMOND_SECONDS=1800
# حداقل شرط بازی‌های گروهی (سکه)
GAME_MIN_STAKE=20
# شماره کارت و قیمت‌ها رو از خود ربات تنظیم کن: /admin ← «💳 تنظیم کارت و قیمت‌ها»

# Optional: reports forum group ID (must differ from GAME_CHAT_ID)
REPORTS_FORUM_ID=
